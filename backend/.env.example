# Copy to .env and fill in real values. Never commit .env itself.

# ── Core Django ──────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──────────────────────────────────────────────────────────────────
# postgres://user:password@host:port/dbname
DATABASE_URL=
DB_SCHEMA=public

# ── Auth token lifetimes (optional — defaults shown) ─────────────────────────
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# ── AI (Claude) ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Voice (Khaya AI — Twi/Dagbani/Ewe/Ga/Frafra; Google STT — Hausa) ─────────
KHAYA_API_KEY=
GOOGLE_CLOUD_STT_API_KEY=

# ── SMS (Africa's Talking) ────────────────────────────────────────────────────
AT_USERNAME=
AT_API_KEY=

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# ── WebRTC TURN relay (Xirsys) ─────────────────────────────────────────────────
XIRSYS_IDENT=
XIRSYS_SECRET=
XIRSYS_CHANNEL=

# ── WebRTC TURN relay fallback (Twilio) ───────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
